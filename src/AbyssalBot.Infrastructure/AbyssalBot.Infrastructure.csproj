<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Domain Layer Reference -->
    <ProjectReference Include="..\AbyssalBot.Domain\AbyssalBot.Domain.csproj" />

    <!-- Sanderling Memory Reading -->
    <ProjectReference Include="..\Sanderling\Sanderling.csproj" />
    <ProjectReference Include="..\Sanderling.Interface\Sanderling.Interface.csproj" />

    <!-- Bot Engine Motor -->
    <ProjectReference Include="..\BotEngine.Common\BotEngine.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Caching -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.0" />

    <!-- Database -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- Telemetry -->
    <PackageReference Include="OpenTelemetry" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.10.0" />

    <!-- Input Simulation -->
    <PackageReference Include="InputSimulator" Version="1.0.4" />

    <!-- Serialization -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

</Project>
