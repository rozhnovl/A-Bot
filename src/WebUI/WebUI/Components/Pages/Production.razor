@page "/production"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject ProductionService ProductionData

<PageTitle>Производство</PageTitle>
<div class="page-heading compact-heading"><div><div class="eyebrow">ПЛАН ПРОИЗВОДСТВА</div><h1>Производство</h1><p class="heading-note">Планируйте выпуск, контролируйте сроки и себестоимость партий.</p></div><button class="btn btn-primary" @onclick="ToggleForm">+ Новая работа</button></div>
<div class="metric-grid mini-metrics"><div class="metric-card"><div class="metric-label">АКТИВНЫЕ РАБОТЫ</div><div class="metric-value">@ProductionData.ActiveWorks</div><div class="metric-foot">запланированы или в работе</div></div><div class="metric-card"><div class="metric-label">ПЛАНОВЫЕ ЗАТРАТЫ</div><div class="metric-value">@Money(ProductionData.Works.Where(w => w.Status != WorkStatus.Done).Sum(w => w.EstimatedCost))</div><div class="metric-foot">по открытым работам</div></div><div class="metric-card"><div class="metric-label">ГОТОВО ВСЕГО</div><div class="metric-value">@ProductionData.Works.Count(w => w.Status == WorkStatus.Done) <small>партии</small></div><div class="metric-foot">по записанным работам</div></div></div>
@if (showForm) { <div class="panel form-panel"><div class="panel-heading"><div><h2>Запланировать работу</h2><p>В burndown попадёт только явно указанная ожидаемая чистая прибыль после всех затрат.</p></div><button class="close-button" @onclick="ToggleForm">×</button></div><div class="form-grid"><label>Изделие<input @bind="product" placeholder="Название изделия" /></label><label>Количество<input type="number" @bind="quantity" /></label><label>Плановая себестоимость<input type="number" @bind="cost" /></label><label>Ожидаемая выручка<input type="number" @bind="expectedRevenue" /></label><label>Ожидаемая чистая прибыль<input type="number" @bind="expectedNetProfit" placeholder="Если рассчитана" /></label><label>Срок выпуска<input type="date" @bind="dueDate" /></label></div><div class="form-actions"><button class="btn btn-primary" @onclick="AddWork">Добавить в план</button></div></div> }
<section class="panel table-panel full-panel"><div class="panel-heading"><div><h2>Работы</h2><p>План выпуска и текущий прогресс</p></div></div><div class="table-scroll"><table class="app-table"><thead><tr><th>Изделие</th><th>Объём</th><th>Себестоимость</th><th>Чистая прибыль · прогноз</th><th>Прогресс</th><th>Срок</th><th>Статус</th></tr></thead><tbody>@foreach (var work in ProductionData.Works) { <tr><td><div class="item-cell"><span class="item-avatar">@(work.Type == "Сборка" ? "◈" : "▧")</span><span><strong>@work.Product</strong><small>@work.Type</small></span></div></td><td>@work.Quantity.ToString("N0") шт.</td><td>@Money(work.EstimatedCost)</td><td><button class="btn" @onclick="() => EditProfit(work)">@(work.ExpectedNetProfit is null ? "Указать" : Money(work.ExpectedNetProfit.Value))</button></td><td><div class="progress-wrap"><div class="progress-track"><div class="progress-value" style="width:@work.Progress%"></div></div><span>@work.Progress%</span></div></td><td class="due-date">@work.DueDate.ToString("dd.MM.yyyy")</td><td><span class="status-pill @StatusClass(work.Status)">@StatusText(work.Status)</span></td></tr> }</tbody></table></div></section>
@if (editWorkId is not null) { <div class="panel form-panel"><div class="panel-heading"><div><h2>Прогноз чистой прибыли для работы #@editWorkId</h2><p>Учитывайте себестоимость, налоги, комиссии и прочие затраты.</p></div><button class="close-button" @onclick="() => editWorkId = null">×</button></div><div class="form-grid"><label>Ожидаемая чистая прибыль<input type="number" @bind="editNetProfit" placeholder="Если рассчитана" /></label></div><div class="form-actions"><button class="btn btn-primary" @onclick="SaveProfit">Сохранить</button></div></div> }
@code { private bool showForm; private string product = ""; private int quantity = 1; private decimal cost; private decimal expectedRevenue; private decimal? expectedNetProfit; private int? editWorkId; private decimal? editNetProfit; private DateTime dueDate = DateTime.Today.AddDays(7); private void ToggleForm() => showForm = !showForm; private void AddWork() { ProductionData.AddWork(product, quantity, cost, dueDate, expectedRevenue, expectedNetProfit); product = ""; quantity = 1; cost = 0; expectedRevenue = 0; expectedNetProfit = null; showForm = false; } private void EditProfit(ProductionWork work) { editWorkId = work.Id; editNetProfit = work.ExpectedNetProfit; } private void SaveProfit() { if (editWorkId is null) return; ProductionData.SetExpectedNetProfit(editWorkId.Value, editNetProfit); editWorkId = null; } private static string Money(decimal v) => $"{v:N0} ISK"; private static string StatusText(WorkStatus s) => s switch { WorkStatus.InProgress => "В работе", WorkStatus.Planned => "Запланировано", _ => "Готово" }; private static string StatusClass(WorkStatus s) => s switch { WorkStatus.InProgress => "purple-pill", WorkStatus.Planned => "blue-pill", _ => "green-pill" }; }
